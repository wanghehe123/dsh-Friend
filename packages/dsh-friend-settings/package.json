{
  "name": "@wishp3/dsh-friend-settings",
  "version": "0.1.1",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "设置父卡片、配置中心小窗与路由",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "settingsScope"
      ]
    }
  },
  "dependencies": {
    "@wishp3/dsh-friend-asr": "workspace:*",
    "@wishp3/dsh-friend-shared": "workspace:*",
    "@wishp3/dsh-friend-tts": "workspace:*"
  },
  "homepage": "https://github.com/wanghehe123/dsh-Friend",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanghehe123/dsh-Friend.git"
  },
  "bugs": {
    "url": "https://github.com/wanghehe123/dsh-Friend/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness"
  ]
}
