{
  "name": "@wish233/dsh-friend-settings",
  "version": "0.1.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "设置父卡片、配置中心小窗与路由",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "settingsScope"
      ]
    }
  },
  "dependencies": {
    "@wish233/dsh-friend-asr": "workspace:*",
    "@wish233/dsh-friend-shared": "workspace:*",
    "@wish233/dsh-friend-tts": "workspace:*"
  }
}
